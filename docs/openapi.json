  "components": {
    "schemas": {
      "BacktestInput": {
        "properties": {
          "strategy_id": {
            "type": "string",
            "title": "Strategy Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "strategy_id"
        ],
        "title": "BacktestInput"
      },
      "DatasetInput": {
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,80}$",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Name"
          },
          "kind": {
            "type": "string",
            "enum": [
              "REAL",
              "SYNTHETIC"
            ],
            "title": "Kind"
          },
          "start_ts": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Start Ts"
          },
          "end_ts": {
            "type": "integer",
            "minimum": 0.0,
            "title": "End Ts"
          },
          "resolution_seconds": {
            "type": "integer",
            "maximum": 86400.0,
            "minimum": 1.0,
            "title": "Resolution Seconds"
          },
          "tokens": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "maxItems": 100,
            "minItems": 1,
            "title": "Tokens"
          },
          "wallets": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 10000,
            "title": "Wallets"
          },
          "events": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "maxItems": 250000,
            "title": "Events"
          },
          "provenance": {
            "additionalProperties": true,
            "type": "object",
            "title": "Provenance"
          },
          "limitations": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Limitations"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "name",
          "kind",
          "start_ts",
          "end_ts",
          "resolution_seconds",
          "tokens",
          "wallets",
          "events",
          "provenance"
        ],
        "title": "DatasetInput"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "IngestionInput": {
        "properties": {
          "wallets": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 10,
            "minItems": 1,
            "title": "Wallets"
          },
          "start_ts": {
            "type": "integer",
            "minimum": 1704067200.0,
            "title": "Start Ts"
          },
          "end_ts": {
            "type": "integer",
            "title": "End Ts"
          },
          "max_pages": {
            "type": "integer",
            "maximum": 200.0,
            "minimum": 1.0,
            "title": "Max Pages",
            "default": 20
          },
          "include_prices": {
            "type": "boolean",
            "title": "Include Prices",
            "default": true
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "wallets",
          "start_ts",
          "end_ts"
        ],
        "title": "IngestionInput"
      },
      "StrategyInput": {
        "properties": {
          "dataset_id": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Dataset Id"
          },
          "config": {
            "additionalProperties": true,
            "type": "object",
            "title": "Config"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "dataset_id"
        ],
        "title": "StrategyInput"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}